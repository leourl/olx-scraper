SECRET_KEY=dev
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5001
DATABASE_URL=sqlite:///instance/olx.db
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
SCRAPER_DELAY=1.0
SCRAPER_MAX_PAGES=5
SCRAPER_TIMEOUT=30

DEEPSEEK_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_MAX_CHARS=1500
LLM_TIMEOUT=60
LLM_REASONING_EFFORT=none
LLM_MAX_RETRIES=2

# Autorun (APScheduler in-app)
AUTORUN_ENABLED=0
AUTORUN_INTERVAL_MINUTES=120

# Logging (LOG_FILE "" = só console; relativo → instance/)
LOG_LEVEL=INFO
LOG_FILE=
